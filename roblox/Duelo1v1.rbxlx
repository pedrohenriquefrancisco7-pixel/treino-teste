      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	Configuração do Duelo 1v1 (as mesmas regras do 1v1.html).
	Distâncias do jogo web estão em metros; aqui tudo vira studs com M (studs por metro).
]]
local Config = {}

Config.M = 3.5 -- studs por metro (um avatar de ~5 studs fica com ~1,5 m de tronco+cabeça)

-- Regras
Config.MAX_LIVES = 3
Config.WIN_SCORE = 10
Config.HEAD_DAMAGE = 3
Config.BODY_DAMAGE = 1
Config.COUNTDOWN = 3 -- segundos (3 → 0)
Config.ROUND_END = 1.8 -- pausa depois de alguém zerar as vidas
Config.FIRE_INTERVAL = 0.15 -- ~6,7 tiros/s
Config.MAG = 12
Config.RELOAD = 1.75
Config.RANGE = 300 -- studs

-- Movimento (m/s → studs/s)
Config.RUN_SPEED = 5.6 * Config.M
Config.WALK_SPEED = 2.9 * Config.M

-- Erro de mira por velocidade (m/s → graus), igual ao 1v1.html:
-- parado = cravado; andando com Shift = abre pouco; correndo = abre muito.
function Config.spreadForSpeed(metersPerSecond: number): number
	if metersPerSecond > 2.9 + 0.3 then
		return 7.5
	elseif metersPerSecond > 1.0 then
		return 2.2
	elseif metersPerSecond > 0.5 then
		return 0.8
	end
	return 0
end

-- Dificuldades do bot (mesmos números do jogo web)
Config.DIFFS = {
	facil = { name = "Fácil", react = 0.75, acc = 0.22, head = 0.04, fire = 0.45 },
	normal = { name = "Normal", react = 0.45, acc = 0.35, head = 0.10, fire = 0.30 },
	dificil = { name = "Difícil", react = 0.27, acc = 0.50, head = 0.18, fire = 0.21 },
}
Config.DIFF_ORDER = { "facil", "normal", "dificil" }

-- Mapa (metros). Galpão com corredores nas duas pontas.
Config.ROOM_X = 11.94
Config.ROOM_Z = 15.78
Config.COR_X = 2.88
Config.COR_Z = 22.0
Config.WALL_H = 6.5
Config.WALL_T = 0.5

-- Caixas: metade da planta (unidade da planta = 0,12 m, centro em 222,5 × 223,5);
-- a outra metade é espelhada pelo centro, trocando madeira por metal.
local SC, PX, PY = 0.12, 222.5, 223.5
local HALF = {
	{ 223, 132.5, 46, 15, 0, 1.25, "wood" },
	{ 172, 158, 15, 15, 28, 1.0, "metal" },
	{ 251, 178, 24, 15, 22, 2.0, "metal" },
	{ 272, 192, 18, 13, 22, 1.15, "wood" },
	{ 139, 200, 32, 12, 0, 2.0, "wood" },
	{ 133, 212, 20, 11, 0, 1.1, "metal" },
}

-- Lista final de caixas: { x, z, largura, profundidade, altura, rotaçãoGraus, tipo } em metros
Config.BOXES = {}
local function addBox(px, py, w, d, deg, h, kind)
	table.insert(Config.BOXES, {
		x = (px - PX) * SC,
		z = (py - PY) * SC,
		w = w * SC,
		d = d * SC,
		h = h,
		deg = deg,
		kind = kind,
	})
end
for _, b in ipairs(HALF) do
	addBox(b[1], b[2], b[3], b[4], b[5], b[6], b[7])
end
for _, b in ipairs(HALF) do
	addBox(445 - b[1], 447 - b[2], b[3], b[4], b[5], b[6], if b[7] == "wood" then "metal" else "wood")
end
addBox(222.5, 223.5, 20, 20, 0, 2.3, "metal")

-- Nascimento (metros): cada um numa ponta, olhando para o outro
Config.SPAWNS = {
	{ x = 0, z = -(22.0 - 1.6) },
	{ x = 0, z = 22.0 - 1.6 },
}

-- Cores
Config.ENEMY_COLOR = Color3.fromRGB(242, 194, 48) -- cápsula amarela
Config.ACCENT = Color3.fromRGB(95, 212, 232)

return Config
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="4">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="5">
      <Properties>
        <string name="Name">DueloServer</string>
      </Properties>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Bot</string>
          <string name="Source"><![CDATA[--[[
	Bot do 1v1: cápsula amarela com cabeça redonda, mesma lógica do 1v1.html.
	- Vendo você: vira para você, faz "strafe" (anda de lado) e atira depois do tempo de reação.
	- Sem ver: procura você pelo mapa com o PathfindingService (refaz o caminho a cada 0,6 s).
	O modelo é ancorado e movido por script (PivotTo), então não depende de física.
]]
local PathfindingService = game:GetService("PathfindingService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Duelo"):WaitForChild("Config"))

local M = Config.M
local Bot = {}
Bot.__index = Bot

-- Medidas em studs, no tamanho de um avatar do Roblox (~5,4 studs), para o duelo ser justo.
local BODY_R = 0.9 -- raio da cápsula
local BODY_MID = 2.4 -- parte reta da cápsula
local HEAD_R = 0.55
local HEAD_Y = 4.85
Bot.EYE = HEAD_Y
Bot.RADIUS = 1.2 -- raio para colisão com o mapa

local function makePart(model, name, shape, size, hit)
	local p = Instance.new("Part")
	p.Name = name
	p.Shape = shape
	p.Size = size
	p.Anchored = true
	p.CanCollide = false -- sem colisão: senão o próprio bot vira obstáculo no cálculo de caminho
	p.CanQuery = true -- mas os tiros (raycast) acertam
	p.CastShadow = true
	p.Color = Config.ENEMY_COLOR
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p:SetAttribute("Hit", hit) -- "head" tira 3 vidas, "body" tira 1
	p.Parent = model
	return p
end

function Bot.new(parent: Instance, mapModel: Instance)
	local self = setmetatable({}, Bot)
	local model = Instance.new("Model")
	model.Name = "Bot"

	-- cápsula: cilindro (eixo X do Roblox, então gira 90°) + duas esferas
	local d = BODY_R * 2
	local base = makePart(model, "Base", Enum.PartType.Ball, Vector3.new(d, d, d), "body")
	local corpo = makePart(model, "Corpo", Enum.PartType.Cylinder, Vector3.new(BODY_MID, d, d), "body")
	local topo = makePart(model, "Topo", Enum.PartType.Ball, Vector3.new(d, d, d), "body")
	local pescoco = makePart(model, "Pescoco", Enum.PartType.Cylinder, Vector3.new(0.45, 0.42, 0.42), "body")
	local cabeca = makePart(model, "Cabeca", Enum.PartType.Ball, Vector3.new(HEAD_R * 2, HEAD_R * 2, HEAD_R * 2), "head")
	-- posições relativas aos pés (CFrame de referência = pés, olhando para -Z)
	self.offsets = {
		[base] = CFrame.new(0, BODY_R, 0),
		[corpo] = CFrame.new(0, BODY_R + BODY_MID / 2, 0) * CFrame.Angles(0, 0, math.rad(90)),
		[topo] = CFrame.new(0, BODY_R + BODY_MID, 0),
		[pescoco] = CFrame.new(0, BODY_R * 2 + BODY_MID - 0.05, 0) * CFrame.Angles(0, 0, math.rad(90)),
		[cabeca] = CFrame.new(0, HEAD_Y, 0),
	}
	model.PrimaryPart = corpo
	model.Parent = parent

	self.model = model
	self.map = mapModel
	self.pos = Vector3.zero -- pés
	self.yaw = 0
	self.vel = Vector3.zero
	self.dead = false
	self.fall = 0
	self.walk = 0

	self.losParams = RaycastParams.new()
	self.losParams.FilterType = Enum.RaycastFilterType.Include
	self.losParams.FilterDescendantsInstances = { mapModel }

	self.path = PathfindingService:CreatePath({
		AgentRadius = 1.6,
		AgentHeight = 5.5,
		AgentCanJump = false,
		WaypointSpacing = 3,
	})
	self:resetState()
	return self
end

function Bot:resetState()
	self.waypoints = {}
	self.repath = 0
	self.pathBusy = false
	self.react = 0
	self.fire = 0.4
	self.mag = Config.MAG
	self.reload = 0
	self.strafe = 0
	self.strafeT = 0
	self.lastSeen = nil
	self.vel = Vector3.zero
end

function Bot:place()
	local root = CFrame.new(self.pos) * CFrame.Angles(0, self.yaw, 0)
	if self.fall > 0 then
		-- cai para trás girando pelos pés
		root = root * CFrame.Angles(self.fall * 1.45, 0, 0)
	elseif self.vel.Magnitude > 2 then
		root = root * CFrame.Angles(0, 0, math.sin(self.walk) * 0.05) -- balanço leve ao andar
	end
	for p, off in pairs(self.offsets) do
		p.CFrame = root * off
	end
end

function Bot:reset(spawnCF: CFrame)
	self:resetState()
	self.dead = false
	self.fall = 0
	self.pos = Vector3.new(spawnCF.Position.X, 0, spawnCF.Position.Z)
	local look = spawnCF.LookVector
	self.yaw = math.atan2(-look.X, -look.Z)
	self:place()
end

function Bot:muzzlePosition(): Vector3
	local root = CFrame.new(self.pos) * CFrame.Angles(0, self.yaw, 0)
	return (root * CFrame.new(0.5, 3.6, -1.3)).Position
end

-- só o mapa segura a visão
function Bot:clear(a: Vector3, b: Vector3): boolean
	local dir = b - a
	return workspace:Raycast(a, dir * ((dir.Magnitude - 0.2) / math.max(dir.Magnitude, 1e-3)), self.losParams) == nil
end

local function turnTo(cur, target, rate)
	local d = target - cur
	while d > math.pi do
		d -= math.pi * 2
	end
	while d < -math.pi do
		d += math.pi * 2
	end
	return cur + math.clamp(d, -rate, rate)
end

function Bot:computePath(target: Vector3)
	if self.pathBusy then
		return
	end
	self.pathBusy = true
	local from = self.pos + Vector3.new(0, 2.5, 0)
	task.spawn(function()
		local ok = pcall(function()
			self.path:ComputeAsync(from, target)
		end)
		local list = {}
		if ok and self.path.Status == Enum.PathStatus.Success then
			for _, w in ipairs(self.path:GetWaypoints()) do
				table.insert(list, Vector3.new(w.Position.X, 0, w.Position.Z))
			end
		end
		self.waypoints = list
		self.pathBusy = false
	end)
end

-- anda até onde dá: se a parede estiver na frente, para (e troca o lado do strafe)
function Bot:step(move: Vector3)
	if move.Magnitude < 1e-4 then
		return
	end
	local origin = self.pos + Vector3.new(0, 2.5, 0)
	local hit = workspace:Raycast(origin, move.Unit * (move.Magnitude + Bot.RADIUS), self.losParams)
	if hit then
		self.strafe = -self.strafe
		return
	end
	self.pos += move
end

--[[
	ctx = {
		live = boolean,
		targetChar = Model?  (personagem do jogador)
		diff = tabela de Config.DIFFS
		shoot = function(seeHead, seeBody, distMeters)  -- chamado quando o bot dispara
	}
]]
function Bot:update(dt: number, ctx)
	if self.dead then
		self.fall = math.min(1, self.fall + dt * 3.6)
		self.vel = Vector3.zero
		self:place()
		return
	end
	local char = ctx.targetChar
	local head = char and char:FindFirstChild("Head")
	local torso = char and char:FindFirstChild("HumanoidRootPart")
	if not ctx.live or not head or not torso then
		self.vel = Vector3.zero
		self:place()
		return
	end

	local D = ctx.diff
	local eye = self.pos + Vector3.new(0, Bot.EYE, 0)
	local seeHead = self:clear(eye, head.Position)
	local seeBody = self:clear(eye, torso.Position)
	local sees = seeHead or seeBody
	local flat = Vector3.new(torso.Position.X - self.pos.X, 0, torso.Position.Z - self.pos.Z)
	local dist = flat.Magnitude
	local wish = Vector3.zero
	local speed = 0

	if self.reload > 0 then
		self.reload -= dt
		if self.reload <= 0 then
			self.mag = Config.MAG
		end
	end

	if sees then
		self.lastSeen = Vector3.new(torso.Position.X, 0, torso.Position.Z)
		self.react += dt
		self.yaw = turnTo(self.yaw, math.atan2(-flat.X, -flat.Z), dt * 9)
		self.strafeT -= dt
		if self.strafeT <= 0 then
			self.strafe = ({ -1, 0, 1 })[math.random(1, 3)]
			self.strafeT = 0.25 + math.random() * 0.6
		end
		if self.strafe ~= 0 and dist > 0 then
			wish = Vector3.new(-flat.Z / dist * self.strafe, 0, flat.X / dist * self.strafe)
			speed = 3.6 * M
		end
		self.fire -= dt
		if self.react >= D.react and self.fire <= 0 and self.reload <= 0 then
			if self.mag <= 0 then
				self.reload = Config.RELOAD
			else
				self.mag -= 1
				self.fire = D.fire * (0.85 + math.random() * 0.5)
				ctx.shoot(seeHead, seeBody, dist / M)
				if self.mag == 0 then
					self.reload = Config.RELOAD
				end
			end
		end
	else
		self.react = math.max(0, self.react - dt * 1.5)
		self.repath -= dt
		if self.repath <= 0 or #self.waypoints == 0 then
			self.repath = 0.6
			local tgt = if self.lastSeen and math.random() < 0.5
				then self.lastSeen
				else Vector3.new(torso.Position.X, 0, torso.Position.Z)
			self:computePath(tgt + Vector3.new(0, 2.5, 0))
			self.lastSeen = nil
		end
		while #self.waypoints > 0 and (self.waypoints[1] - self.pos).Magnitude < 1 do
			table.remove(self.waypoints, 1)
		end
		local nextPoint = self.waypoints[1]
		if not nextPoint and not self.pathBusy and dist > 2 then
			-- sem caminho calculado: vai direto (o passo para na parede)
			nextPoint = Vector3.new(torso.Position.X, 0, torso.Position.Z)
		end
		if nextPoint and (nextPoint - self.pos).Magnitude > 1e-3 then
			wish = (nextPoint - self.pos).Unit
			speed = 5.0 * M
			self.yaw = turnTo(self.yaw, math.atan2(-wish.X, -wish.Z), dt * 7)
		end
	end

	local k = math.min(1, dt * 12)
	self.vel += (wish * speed - self.vel) * k
	self:step(self.vel * dt)
	self.walk += self.vel.Magnitude / M * dt * 2.2
	self:place()
end

function Bot:destroy()
	self.model:Destroy()
end

return Bot
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="7">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Servidor do Duelo 1v1.
	- Uma partida por servidor: você contra o bot, ou dois jogadores (Contra Player).
	- O servidor manda em tudo que importa: munição, cadência, erro de mira e acertos.
	  O jogador só envia "atirei daqui, nesta direção"; o raio é calculado aqui.
	Regras: 3 vidas por rodada, peito tira 1, cabeça tira 3, quem zerar o outro ganha 1 ponto,
	primeiro a 10 vence. Contagem 3 → 0 antes de cada rodada.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Duelo")
local Config = require(Shared:WaitForChild("Config"))
local MapBuilder = require(script.Parent:WaitForChild("MapBuilder"))
local Bot = require(script.Parent:WaitForChild("Bot"))

local M = Config.M

---------------------------------------------------------------- remotos
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local function remote(name)
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = remotes
	return r
end
local FireRE = remote("Fire") -- C→S (origem, direção)
local ReloadRE = remote("Reload") -- C→S
local ReadyRE = remote("Ready") -- C→S ("bot" | "pvp", dificuldade)
local LeaveRE = remote("Leave") -- C→S
local StateRE = remote("State") -- S→C (estado da partida)
local EffectRE = remote("Effect") -- S→C (traçante e marca de tiro)
local HitRE = remote("Hit") -- S→C só para quem acertou (cabeça?)
remotes.Parent = Shared -- só depois de criar todos, para o cliente achar tudo de uma vez

---------------------------------------------------------------- mapa
local map = MapBuilder.build()
local effectsFolder = Instance.new("Folder")
effectsFolder.Name = "Efeitos"
effectsFolder.Parent = workspace

---------------------------------------------------------------- estado
local S = {
	phase = "menu", -- menu | countdown | live | roundEnd | over
	mode = "bot",
	diff = "normal",
	score = { 0, 0 },
	lives = { Config.MAX_LIVES, Config.MAX_LIVES },
	names = { "", "" },
	userIds = { 0, 0 }, -- 0 = bot
	cdEnd = 0, -- hora do servidor em que a contagem termina
	winner = 0,
	waiting = {}, -- nomes de quem está esperando adversário (Contra Player)
}
local slots = { nil, nil } -- [1], [2] = Player ou "bot"
local bot = nil
local roundEndAt = 0
local wantPvp = {} -- [Player] = true
local guns = {} -- [Player] = { mag, last, reloadEnd, token }

local function now()
	return workspace:GetServerTimeNow()
end

local function publicState()
	local waiting = {}
	for p in pairs(wantPvp) do
		table.insert(waiting, p.Name)
	end
	S.waiting = waiting
	return S
end

local function broadcast()
	StateRE:FireAllClients(publicState())
end

local function slotOf(player)
	if slots[1] == player then
		return 1
	elseif slots[2] == player then
		return 2
	end
	return nil
end

local function charOfSlot(i)
	local s = slots[i]
	if typeof(s) == "Instance" and s:IsA("Player") then
		return s.Character
	end
	return nil
end

---------------------------------------------------------------- arma do jogador (no servidor)
local function gunOf(player)
	local g = guns[player]
	if not g then
		g = { mag = Config.MAG, last = 0, reloadEnd = 0, token = 0 }
		guns[player] = g
	end
	return g
end

local function refillGun(player)
	local g = gunOf(player)
	g.mag = Config.MAG
	g.reloadEnd = 0
	g.token += 1
	player:SetAttribute("Mag", g.mag)
	player:SetAttribute("Reloading", false)
end

local function startReload(player)
	local g = gunOf(player)
	if g.reloadEnd > os.clock() or g.mag == Config.MAG then
		return
	end
	g.reloadEnd = os.clock() + Config.RELOAD
	g.token += 1
	local token = g.token
	player:SetAttribute("Reloading", true)
	task.delay(Config.RELOAD, function()
		if guns[player] == g and g.token == token then
			g.mag = Config.MAG
			g.reloadEnd = 0
			player:SetAttribute("Mag", g.mag)
			player:SetAttribute("Reloading", false)
		end
	end)
end

---------------------------------------------------------------- rodadas
local function placeAtSpawn(i)
	local cf = MapBuilder.spawnCFrame(i)
	local s = slots[i]
	if s == "bot" then
		if bot then
			bot:reset(cf)
		end
	else
		local char = charOfSlot(i)
		if char and char.PrimaryPart then
			char:PivotTo(cf)
			char.PrimaryPart.AssemblyLinearVelocity = Vector3.zero
		end
		if s then
			refillGun(s)
		end
	end
end

local function newRound()
	S.lives = { Config.MAX_LIVES, Config.MAX_LIVES }
	S.phase = "countdown"
	S.cdEnd = now() + Config.COUNTDOWN
	placeAtSpawn(1)
	placeAtSpawn(2)
	broadcast()
end

local function endMatch(reason)
	slots = { nil, nil }
	if bot then
		bot:destroy()
		bot = nil
	end
	S.phase = "menu"
	S.names = { "", "" }
	S.userIds = { 0, 0 }
	S.score = { 0, 0 }
	S.lives = { Config.MAX_LIVES, Config.MAX_LIVES }
	S.note = reason
	broadcast()
	S.note = nil
end

local function startMatch(a, b, mode, diff)
	slots = { a, b }
	S.mode = mode
	S.diff = diff or S.diff
	S.score = { 0, 0 }
	S.winner = 0
	S.names = { a.Name, if b == "bot" then "Bot " .. Config.DIFFS[S.diff].name else b.Name }
	S.userIds = { a.UserId, if b == "bot" then 0 else b.UserId }
	if bot then
		bot:destroy()
		bot = nil
	end
	if b == "bot" then
		bot = Bot.new(workspace, map)
	end
	newRound()
end

-- Só o servidor chama: tira vidas, marca ponto, fecha rodada ou partida.
local function applyHit(victim, part)
	if S.phase ~= "live" or S.lives[victim] <= 0 then
		return
	end
	local dmg = if part == "head" then Config.HEAD_DAMAGE else Config.BODY_DAMAGE
	S.lives[victim] = math.max(0, S.lives[victim] - dmg)
	if S.lives[victim] == 0 then
		local winner = 3 - victim
		S.score[winner] += 1
		if slots[victim] == "bot" and bot then
			bot.dead = true
		end
		if S.score[winner] >= Config.WIN_SCORE then
			S.phase = "over"
			S.winner = winner
		else
			S.phase = "roundEnd"
			roundEndAt = os.clock() + Config.ROUND_END
		end
	end
	broadcast()
end

---------------------------------------------------------------- tiros dos jogadores
local function applySpread(dir: Vector3, deg: number): Vector3
	local sp = math.rad(deg) * math.sqrt(math.random())
	local a = math.random() * math.pi * 2
	local right = dir:Cross(Vector3.yAxis)
	if right.Magnitude < 1e-3 then
		right = Vector3.xAxis
	end
	right = right.Unit
	local up = right:Cross(dir).Unit
	local t = math.tan(sp)
	return (dir + right * math.cos(a) * t + up * math.sin(a) * t).Unit
end

-- O que a bala acertou: (slot da vítima, "head"/"body") ou nil
local function targetOf(inst: Instance)
	if bot and inst:IsDescendantOf(bot.model) then
		for i = 1, 2 do
			if slots[i] == "bot" then
				return i, inst:GetAttribute("Hit") or "body"
			end
		end
	end
	local model = inst:FindFirstAncestorOfClass("Model")
	local player = model and Players:GetPlayerFromCharacter(model)
	local i = player and slotOf(player)
	if i then
		return i, if inst.Name == "Head" then "head" else "body"
	end
	return nil
end

FireRE.OnServerEvent:Connect(function(player, origin, dir)
	if typeof(origin) ~= "Vector3" or typeof(dir) ~= "Vector3" then
		return
	end
	local slot = slotOf(player)
	if not slot or S.phase ~= "live" or S.lives[slot] <= 0 then
		return
	end
	if dir.Magnitude < 0.5 or dir.Magnitude ~= dir.Magnitude then
		return
	end
	local g = gunOf(player)
	local t = os.clock()
	if t - g.last < Config.FIRE_INTERVAL * 0.8 or g.reloadEnd > t then
		return
	end
	if g.mag <= 0 then
		startReload(player)
		return
	end
	local char = player.Character
	local head = char and char:FindFirstChild("Head")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not head or not root then
		return
	end
	g.mag -= 1
	g.last = t
	player:SetAttribute("Mag", g.mag)

	-- a origem tem que estar perto da cabeça (a câmera em 1ª pessoa fica ali)
	if (origin - head.Position).Magnitude > 4 then
		origin = head.Position
	end
	dir = dir.Unit
	-- erro de mira calculado aqui, pela velocidade que o servidor vê
	local v = root.AssemblyLinearVelocity
	local spread = Config.spreadForSpeed(Vector3.new(v.X, 0, v.Z).Magnitude / M)
	if spread > 0 then
		dir = applySpread(dir, spread)
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { char, effectsFolder }
	local res = workspace:Raycast(origin, dir * Config.RANGE, params)
	local endPos = if res then res.Position else origin + dir * Config.RANGE
	local decalNormal = nil
	if res then
		local victim, part = targetOf(res.Instance)
		if victim and victim ~= slot then
			HitRE:FireClient(player, part == "head")
			applyHit(victim, part)
		elseif not victim then
			decalNormal = res.Normal
		end
	end
	EffectRE:FireAllClients(player.UserId, origin, endPos, decalNormal)
	if g.mag == 0 then
		task.delay(0.25, function()
			if g.mag == 0 then
				startReload(player)
			end
		end)
	end
end)

ReloadRE.OnServerEvent:Connect(function(player)
	if slotOf(player) then
		startReload(player)
	end
end)

---------------------------------------------------------------- tiros do bot
local function botShoot(seeHead, seeBody, distM)
	local victim = if slots[1] == "bot" then 2 else 1
	local char = charOfSlot(victim)
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local head = char and char:FindFirstChild("Head")
	if not root or not head or not bot then
		return
	end
	local D = Config.DIFFS[S.diff]
	local pv = root.AssemblyLinearVelocity
	local pSpeed = Vector3.new(pv.X, 0, pv.Z).Magnitude / M
	local bSpeed = bot.vel.Magnitude / M
	local chance = D.acc
		* (if pSpeed > 2 then 0.7 else 1)
		* (if bSpeed > 1 then 0.8 else 1)
		* math.clamp(1.15 - distM / 40, 0.6, 1.1)
	if not seeBody then
		chance *= 0.55
	end
	local from = bot:muzzlePosition()
	if math.random() < chance then
		local part = if not seeBody then "head" elseif math.random() < D.head then "head" else "body"
		local to = if part == "head" then head.Position else root.Position
		EffectRE:FireAllClients(0, from, to, nil)
		applyHit(victim, part)
	else
		-- erra para o lado e um pouco para cima ou para baixo
		local side = Vector3.new(-(root.Position.Z - from.Z), 0, root.Position.X - from.X)
		side = if side.Magnitude > 0 then side.Unit else Vector3.xAxis
		local to = root.Position
			+ side * ((if math.random() < 0.5 then -1 else 1) * (0.45 + math.random() * 0.6) * M)
			+ Vector3.new(0, (math.random() - 0.3) * 0.8 * M, 0)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Include
		params.FilterDescendantsInstances = { map }
		local dir = (to - from).Unit
		local res = workspace:Raycast(from, dir * Config.RANGE, params)
		EffectRE:FireAllClients(0, from, if res then res.Position else from + dir * 80, if res then res.Normal else nil)
	end
end

---------------------------------------------------------------- menu: começar partida
ReadyRE.OnServerEvent:Connect(function(player, mode, diff)
	if mode ~= "bot" and mode ~= "pvp" then
		return
	end
	if typeof(diff) ~= "string" or not Config.DIFFS[diff] then
		diff = "normal"
	end
	local busy = S.phase ~= "menu" and S.phase ~= "over"
	if busy and not slotOf(player) then
		return -- já tem partida rolando neste servidor
	end
	if mode == "bot" then
		wantPvp[player] = nil
		startMatch(player, "bot", "bot", diff)
		return
	end
	-- Contra Player: espera outra pessoa também pedir
	wantPvp[player] = true
	for other in pairs(wantPvp) do
		if other ~= player and other.Parent == Players then
			wantPvp[player] = nil
			wantPvp[other] = nil
			startMatch(other, player, "pvp", diff)
			return
		end
	end
	if S.phase == "over" and slotOf(player) then
		-- revanche contra player: volta para a espera
		S.phase = "menu"
	end
	broadcast()
end)

LeaveRE.OnServerEvent:Connect(function(player)
	wantPvp[player] = nil
	if slotOf(player) then
		endMatch(player.Name .. " saiu da partida.")
	else
		broadcast()
	end
end)

---------------------------------------------------------------- jogadores
local function setupCharacter(player, char)
	-- chapéus e acessórios não seguram tiro (só cabeça e corpo contam)
	local function noQuery(d)
		if d:IsA("BasePart") and d:FindFirstAncestorOfClass("Accessory") then
			d.CanQuery = false
		end
	end
	for _, d in ipairs(char:GetDescendants()) do
		noQuery(d)
	end
	char.DescendantAdded:Connect(noQuery)
	local i = slotOf(player)
	if i then
		task.defer(function()
			placeAtSpawn(i)
		end)
	end
end

local function onPlayer(player)
	player:SetAttribute("Mag", Config.MAG)
	player:SetAttribute("Reloading", false)
	player.CharacterAdded:Connect(function(char)
		setupCharacter(player, char)
	end)
	if player.Character then
		setupCharacter(player, player.Character)
	end
	task.defer(function()
		StateRE:FireClient(player, publicState())
	end)
end
Players.PlayerAdded:Connect(onPlayer)
for _, p in ipairs(Players:GetPlayers()) do
	onPlayer(p) -- quem entrou antes deste script rodar (acontece no Studio)
end

Players.PlayerRemoving:Connect(function(player)
	wantPvp[player] = nil
	guns[player] = nil
	if slotOf(player) then
		endMatch(player.Name .. " saiu do jogo.")
	end
end)

---------------------------------------------------------------- laço principal
local nextSync = 0
RunService.Heartbeat:Connect(function(dt)
	if S.phase == "countdown" and now() >= S.cdEnd then
		S.phase = "live"
		broadcast()
	elseif S.phase == "roundEnd" and os.clock() >= roundEndAt then
		if bot then
			bot.dead = false
		end
		newRound()
	end
	if bot then
		local victim = if slots[1] == "bot" then 2 else 1
		bot:update(dt, {
			live = S.phase == "live" and S.lives[if victim == 1 then 2 else 1] > 0,
			targetChar = charOfSlot(victim),
			diff = Config.DIFFS[S.diff],
			shoot = botShoot,
		})
	end
	-- reenvia o estado de vez em quando (quem entrou atrasado ou perdeu um pacote)
	if os.clock() >= nextSync then
		nextSync = os.clock() + 1
		broadcast()
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[--[[
	Monta o galpão do 1v1 a partir do Config (mesma planta do 1v1.html).
	Tudo é criado por script, então o place não precisa de nada pronto no Workspace.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Duelo"):WaitForChild("Config"))

local M = Config.M
local MapBuilder = {}

local COLORS = {
	floor = Color3.fromRGB(135, 132, 124),
	wall = Color3.fromRGB(214, 195, 160),
	wood = Color3.fromRGB(143, 108, 71),
	metal = Color3.fromRGB(86, 104, 122),
	beam = Color3.fromRGB(110, 79, 51),
	ceiling = Color3.fromRGB(59, 49, 41),
}
local MATERIALS = {
	floor = Enum.Material.Concrete,
	wall = Enum.Material.Plaster,
	wood = Enum.Material.WoodPlanks,
	metal = Enum.Material.DiamondPlate,
	beam = Enum.Material.Wood,
	ceiling = Enum.Material.Wood,
}

local function part(parent, name, kind, sizeM: Vector3, cf: CFrame, opts)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = sizeM * M
	p.CFrame = cf
	p.Color = COLORS[kind] or COLORS.wall
	p.Material = MATERIALS[kind] or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if opts then
		for k, v in pairs(opts) do
			p[k] = v
		end
	end
	p.Parent = parent
	return p
end

-- posição em metros → CFrame em studs
local function at(x: number, y: number, z: number, deg: number?)
	return CFrame.new(x * M, y * M, z * M) * CFrame.Angles(0, math.rad(deg or 0), 0)
end

function MapBuilder.build(): Model
	local old = workspace:FindFirstChild("Galpao")
	if old then
		old:Destroy()
	end
	local map = Instance.new("Model")
	map.Name = "Galpao"

	local RX, RZ, CX, CZ = Config.ROOM_X, Config.ROOM_Z, Config.COR_X, Config.COR_Z
	local H, T = Config.WALL_H, Config.WALL_T

	-- chão e teto
	local fw, fd = RX * 2 + 2, CZ * 2 + 2
	part(map, "Chao", "floor", Vector3.new(fw, 0.2, fd), at(0, -0.1, 0))
	part(map, "Teto", "ceiling", Vector3.new(fw, 0.2, fd), at(0, H + 1.3, 0), { CastShadow = false })
	local beams = Instance.new("Folder")
	beams.Name = "Vigas"
	beams.Parent = map
	local z = -RZ + 1.5
	while z < RZ do
		part(beams, "Viga", "beam", Vector3.new(RX * 2, 0.35, 0.3), at(0, H + 0.9, z), { CanQuery = false })
		z += 3.2
	end
	for _, x in ipairs({ -4, 4 }) do
		part(beams, "Viga", "beam", Vector3.new(0.35, 0.4, RZ * 2), at(x, H + 0.7, 0), { CanQuery = false })
	end

	-- paredes do salão e dos dois corredores
	local walls = Instance.new("Folder")
	walls.Name = "Paredes"
	walls.Parent = map
	local function wall(x, zz, w, d)
		part(walls, "Parede", "wall", Vector3.new(w, H, d), at(x, H / 2, zz))
	end
	local segW = RX - CX
	wall(-RX - T / 2, 0, T, RZ * 2)
	wall(RX + T / 2, 0, T, RZ * 2)
	for _, s in ipairs({ -1, 1 }) do
		wall(-(CX + segW / 2), s * (RZ + T / 2), segW + T, T)
		wall(CX + segW / 2, s * (RZ + T / 2), segW + T, T)
		local cl = CZ - RZ
		wall(-CX - T / 2, s * (RZ + cl / 2), T, cl + T)
		wall(CX + T / 2, s * (RZ + cl / 2), T, cl + T)
		wall(0, s * (CZ + T / 2), CX * 2 + T * 2, T)
	end

	-- rodapé e pilares de madeira (enfeite: não segura tiro, como no jogo web)
	local trims = Instance.new("Folder")
	trims.Name = "Acabamento"
	trims.Parent = map
	for _, s in ipairs({ -1, 1 }) do
		part(trims, "Rodape", "beam", Vector3.new(0.12, 0.8, RZ * 2), at(s * (RX - 0.06), 0.4, 0), { CanQuery = false })
		local pz = -RZ + 2
		while pz < RZ do
			part(trims, "Pilar", "beam", Vector3.new(0.22, H, 0.3), at(s * (RX - 0.11), H / 2, pz), { CanQuery = false, CanCollide = false })
			pz += 4.4
		end
	end

	-- caixas
	local boxes = Instance.new("Folder")
	boxes.Name = "Caixas"
	boxes.Parent = map
	for i, b in ipairs(Config.BOXES) do
		part(boxes, "Caixa" .. i, b.kind, Vector3.new(b.w, b.h, b.d), at(b.x, b.h / 2, b.z, b.deg))
	end

	-- marcação dos locais de nascimento (azul = jogador 1, amarelo = jogador 2)
	for i, sp in ipairs(Config.SPAWNS) do
		part(map, "Base" .. i, "floor", Vector3.new(CX * 2 - 0.2, 0.02, 3), at(sp.x, 0.01, sp.z), {
			Color = if i == 1 then Config.ACCENT else Config.ENEMY_COLOR,
			Material = Enum.Material.SmoothPlastic,
			Transparency = 0.6,
			CanCollide = false,
			CanQuery = false,
		})
	end

	-- onde todo mundo aparece antes da partida (no centro há uma caixa, então fica na lateral do salão)
	local lobby = Instance.new("SpawnLocation")
	lobby.Name = "Entrada"
	lobby.Anchored = true
	lobby.Neutral = true
	lobby.Duration = 0 -- sem campo de força
	lobby.Size = Vector3.new(6, 0.2, 6)
	lobby.CFrame = at(RX - 2.5, 0.01, -7)
	lobby.Transparency = 1
	lobby.CanCollide = false
	lobby.CanQuery = false
	lobby.Parent = map

	map.Parent = workspace
	return map
end

-- CFrame de nascimento (studs) olhando para o centro do mapa
function MapBuilder.spawnCFrame(index: number): CFrame
	local sp = Config.SPAWNS[index]
	local pos = Vector3.new(sp.x * M, 3, sp.z * M)
	return CFrame.lookAt(pos, Vector3.new(0, 3, 0))
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="9">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <token name="CameraMode">1</token>
      <float name="CharacterJumpPower">40</float>
      <float name="CharacterWalkSpeed">19.6</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="10">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="11">
        <Properties>
          <string name="Name">DueloClient</string>
        </Properties>
        <Item class="LocalScript" referent="12">
          <Properties>
            <string name="Name">Client</string>
            <string name="Source"><![CDATA[--[[
	Cliente do Duelo 1v1: telas, placar, mira, pistola em 1ª pessoa e efeitos.
	O cliente só pede ("atirei", "recarregar", "quero jogar"); quem decide é o servidor.
	Controles: WASD andar · Shift andar devagar (tiro preciso) · Clique atirar · R recarregar · P menu da partida
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Duelo")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = Shared:WaitForChild("Remotes")
local FireRE = Remotes:WaitForChild("Fire")
local ReloadRE = Remotes:WaitForChild("Reload")
local ReadyRE = Remotes:WaitForChild("Ready")
local LeaveRE = Remotes:WaitForChild("Leave")
local StateRE = Remotes:WaitForChild("State")
local EffectRE = Remotes:WaitForChild("Effect")
local HitRE = Remotes:WaitForChild("Hit")

local camera = workspace.CurrentCamera

-- esconde mochila e barra de vida padrão (aqui a vida são as 3 vidas do placar)
task.spawn(function()
	for _ = 1, 10 do
		local ok = pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
		end)
		if ok then
			break
		end
		task.wait(0.5)
	end
end)

---------------------------------------------------------------- cores e fontes
local C = {
	bg = Color3.fromRGB(10, 18, 22),
	panel = Color3.fromRGB(16, 27, 33),
	panel2 = Color3.fromRGB(22, 37, 45),
	line = Color3.fromRGB(34, 53, 64),
	fg = Color3.fromRGB(232, 240, 243),
	muted = Color3.fromRGB(138, 161, 173),
	accent = Config.ACCENT,
	ink = Color3.fromRGB(4, 34, 42),
	enemy = Config.ENEMY_COLOR,
	bad = Color3.fromRGB(255, 93, 108),
	good = Color3.fromRGB(110, 231, 168),
}
local F_BOLD = Enum.Font.GothamBold
local F_TEXT = Enum.Font.Gotham
local F_MONO = Enum.Font.RobotoMono

---------------------------------------------------------------- ajudantes de interface
local function make(class, props, children)
	local o = Instance.new(class)
	local parent = props.Parent
	for k, v in pairs(props) do
		if k ~= "Parent" then
			o[k] = v
		end
	end
	if children then
		for _, c in ipairs(children) do
			c.Parent = o
		end
	end
	if parent then
		o.Parent = parent
	end
	return o
end
local function corner(r)
	return make("UICorner", { CornerRadius = UDim.new(0, r) })
end
local function stroke(color, thickness)
	return make("UIStroke", { Color = color, Thickness = thickness or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end
local function pad(px)
	return make("UIPadding", {
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
	})
end
local function list(dir, gap, align)
	return make("UIListLayout", {
		FillDirection = dir,
		Padding = UDim.new(0, gap),
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
	})
end
local function text(props)
	local t = make("TextLabel", {
		BackgroundTransparency = 1,
		Font = props.Font or F_TEXT,
		TextSize = props.TextSize or 16,
		TextColor3 = props.TextColor3 or C.fg,
		Text = props.Text or "",
		TextWrapped = true,
		TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left,
		Size = props.Size or UDim2.new(1, 0, 0, 0),
		AutomaticSize = props.AutomaticSize or Enum.AutomaticSize.Y,
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	})
	return t
end
local function button(label, primary, parent, order)
	return make("TextButton", {
		Text = label,
		Font = F_BOLD,
		TextSize = 17,
		TextColor3 = if primary then C.ink else C.fg,
		BackgroundColor3 = if primary then C.accent else C.panel2,
		AutoButtonColor = true,
		Modal = true, -- solta o mouse da 1ª pessoa enquanto a tela está aberta
		Size = UDim2.new(0, 0, 0, 42),
		AutomaticSize = Enum.AutomaticSize.X,
		LayoutOrder = order or 0,
		Parent = parent,
	}, {
		corner(8),
		stroke(if primary then C.accent else C.line),
		make("UIPadding", { PaddingLeft = UDim.new(0, 18), PaddingRight = UDim.new(0, 18) }),
	})
end
local function row(parent, order, gap)
	return make("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = order or 0,
		Parent = parent,
	}, { list(Enum.FillDirection.Horizontal, gap or 10) })
end
local function card(parent, name)
	return make("Frame", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, 560, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = C.panel,
		Visible = false,
		Parent = parent,
	}, { corner(12), stroke(C.line), pad(24), list(Enum.FillDirection.Vertical, 14) })
end

---------------------------------------------------------------- tela
local gui = make("ScreenGui", {
	Name = "DueloGui",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player:WaitForChild("PlayerGui"),
})
local hud = make("Frame", { Name = "HUD", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = gui })

-- vinheta vermelha ao tomar tiro
local dmgFx = make("Frame", {
	BackgroundColor3 = Color3.fromRGB(255, 40, 60),
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
	Size = UDim2.fromScale(1, 1),
	Parent = hud,
})

-- placar
local scoreBar = make("Frame", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 14),
	Size = UDim2.new(0, 0, 0, 52),
	AutomaticSize = Enum.AutomaticSize.X,
	BackgroundColor3 = C.bg,
	BackgroundTransparency = 0.2,
	Parent = hud,
}, { corner(10), stroke(C.line), list(Enum.FillDirection.Horizontal, 14, Enum.HorizontalAlignment.Center), make("UIPadding", { PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 16) }) })
local function pips(parent, order, color)
	local f = make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0, 44, 0, 12), LayoutOrder = order, Parent = parent }, {
		list(Enum.FillDirection.Horizontal, 4),
	})
	local out = {}
	for i = 1, Config.MAX_LIVES do
		out[i] = make("Frame", { BackgroundColor3 = color, Size = UDim2.new(0, 12, 0, 12), LayoutOrder = i, Parent = f }, { corner(3) })
	end
	return out
end
local function scoreText(order, color, size, font)
	return text({ Parent = scoreBar, LayoutOrder = order, TextColor3 = color, TextSize = size, Font = font, Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, TextXAlignment = Enum.TextXAlignment.Center })
end
local nmMe = scoreText(1, C.muted, 15, F_BOLD)
nmMe.Text = "VOCÊ"
local lvMe = pips(scoreBar, 2, C.accent)
local scMe = scoreText(3, C.accent, 30, F_MONO)
local mid = scoreText(4, C.muted, 12, F_BOLD)
mid.Text = "PRIMEIRO A " .. Config.WIN_SCORE
local scOp = scoreText(5, C.enemy, 30, F_MONO)
local lvOp = pips(scoreBar, 6, C.enemy)
local nmOp = scoreText(7, C.muted, 15, F_BOLD)

-- mira: 4 traços com contorno escuro + ponto

text({ Parent = diffRow, LayoutOrder = 0, Font = F_BOLD, TextSize = 12, TextColor3 = C.muted, Text = "DIFICULDADE DO BOT", Size = UDim2.new(0, 0, 0, 30), AutomaticSize = Enum.AutomaticSize.X })
